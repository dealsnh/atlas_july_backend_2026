NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Comma-separated origins, or * for all (development only)
CORS_ORIGIN=http://localhost:5173

# Atlas client configuration
CLIENT_NAME=Atlas
CLIENT_EMAIL=
CLIENT_COUNTIES=[]

# Optional: persistent SQLite volume path (Railway, Docker, etc.)
# RAILWAY_VOLUME_MOUNT_PATH=/data

# Scraper credentials (can also be stored in DB settings later)
# SCRAPER_API_KEY=
# BRIGHT_DATA_USER=
# BRIGHT_DATA_PASS=
