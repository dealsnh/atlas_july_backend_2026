NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Comma-separated origins, or * for all (development only)
CORS_ORIGIN=http://localhost:5173

# Atlas client configuration
CLIENT_NAME=Atlas
CLIENT_EMAIL=
CLIENT_COUNTIES=[]

# Optional: persistent SQLite volume path (Railway, Docker, etc.)
# RAILWAY_VOLUME_MOUNT_PATH=/data

# API authentication (required in production)
# API_KEY=

# Scraper credentials (can also be stored in DB settings)
# SCRAPER_API_KEY=
# BRIGHT_DATA_USER=
# BRIGHT_DATA_PASS=
# ATTOM_API_KEY=
# SKIP_TRACE_KEY=

# SMTP (can also be stored in DB settings)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
