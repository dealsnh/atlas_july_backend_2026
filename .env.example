NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Comma-separated origins, or * for all (development only)
CORS_ORIGIN=http://localhost:5173

# Atlas client configuration
CLIENT_NAME=Atlas
CLIENT_EMAIL=
# Counties to scrape. Optional per-county lead_types (4–5 recommended); omit to use built-in defaults.
# CLIENT_COUNTIES=[{"name":"Jackson","state":"MO","publicsearch_slug":"jackson","publicsearch_state":"mo","lead_types":["Tax Delinquent","Sheriff Sale","Code Violation","Water Shutoff","Fire Damage"]},{"name":"Hamilton","state":"OH","lead_types":["Pre-Foreclosure","Tax Delinquent","Sheriff Sale","Probate","Fire Damage"]}]
CLIENT_COUNTIES=[]

# PostgreSQL (required)
DATABASE_URL=postgresql://user:password@localhost:5432/atlas
# DATABASE_SSL=true
# DATABASE_POOL_SIZE=10

# Optional: separate DB for tests
# TEST_DATABASE_URL=postgresql://localhost:5432/atlas_test

# API authentication (required in production for mutating routes without JWT)
# API_KEY=

# User authentication (JWT)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
# Optional: auto-create admin on first startup if no users exist
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=your-secure-password

# Scraper credentials (can also be stored in DB settings)
# SCRAPER_API_KEY=
# BRIGHT_DATA_USER=
# BRIGHT_DATA_PASS=
# ATTOM_API_KEY=

# Skip trace (Tracerfy — https://www.tracerfy.com/skip-tracing-api-documentation/)
# SKIP_TRACE_PROVIDER=tracerfy
# SKIP_TRACE_KEY=your-tracerfy-api-key
# SKIP_TRACE_API_URL=https://tracerfy.com/v1/api/trace/lookup/

# SMTP (can also be stored in DB settings; daily reports use CLIENT_EMAIL if email_recipients empty)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Railway CLI deploy token (not read by the application)
# RAILWAY_API_TOKEN=
