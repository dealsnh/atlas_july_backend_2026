NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Comma-separated origins, or * for all (development only)
CORS_ORIGIN=http://localhost:5173

# Atlas client configuration
CLIENT_NAME=Atlas
CLIENT_EMAIL=
CLIENT_COUNTIES=[]

# PostgreSQL (required)
DATABASE_URL=postgresql://user:password@localhost:5432/atlas
# DATABASE_SSL=true
# DATABASE_POOL_SIZE=10

# Optional: separate DB for tests (defaults to local atlas_test when Railway internal URL is set)
# TEST_DATABASE_URL=postgresql://localhost:5432/atlas_test

# API authentication (required in production for /api/v1 mutating routes)
# API_KEY=

# Scraper credentials (can also be stored in DB settings)
# SCRAPER_API_KEY=
# BRIGHT_DATA_USER=
# BRIGHT_DATA_PASS=
# ATTOM_API_KEY=
# SKIP_TRACE_KEY=

# SMTP (can also be stored in DB settings)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
