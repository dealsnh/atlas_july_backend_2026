{
  "name": "atlas-county-scraper-backend",
  "version": "1.0.0",
  "description": "Atlas county scraper API backend",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outdir=dist --sourcemap",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "test": "vitest run",
    "seed": "tsx src/scripts/seed-csvs.ts",
    "test:mo-scraper": "tsx src/scripts/test-mo-scraper.ts",
    "test:flow": "tsx src/scripts/test-flow.ts",
    "test:live": "tsx src/scripts/live-e2e-test.ts",
    "test:frontend": "tsx src/scripts/frontend-e2e-test.ts",
    "test:phase1": "tsx src/scripts/phase1-qa.ts",
    "report:counties": "tsx src/scripts/county-status-report.ts",
    "scrape:historical": "tsx src/scripts/run-historical-scrape.ts",
    "reconcile:leads": "tsx src/scripts/reconcile-placeholder-leads.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jose": "^6.2.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^24.7.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.44.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": "24.13.x"
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
